# Chomelo Jukebox - Backend
# Copia a .env y ajusta los valores para tu entorno.
CHOMELO_ENVIRONMENT=development
CHOMELO_DEBUG=true

CHOMELO_DATABASE_URL=postgresql+asyncpg://chomelo:chomelo@db:5432/chomelo
CHOMELO_REDIS_URL=redis://redis:6379/0
CHOMELO_WORKER_URL=http://worker:9000

CHOMELO_JWT_SECRET=change-me-in-prod
CHOMELO_JWT_ALGORITHM=HS256
CHOMELO_JWT_EXPIRE_MINUTES=15
CHOMELO_JWT_REFRESH_EXPIRE_DAYS=7

CHOMELO_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]